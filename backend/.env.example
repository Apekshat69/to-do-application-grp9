PORT=5000
NODE_ENV=development

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Option A: Cloud Hosted PostgreSQL (Neon, Supabase, Vercel Postgres, AWS RDS)
# Recommended for production deployments on Vercel.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-host.us-east-2.aws.neon.tech/taskflow_db?sslmode=require

# Option B: Local PostgreSQL (when running on localhost:5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=to_do_app_db
DB_USER=postgres
DB_PASSWORD=pass123

# SSL Configuration (default: true for cloud/Neon, set to false for unencrypted local postgres)
DB_SSL=true

# Connection Pool Settings (optimal for Vercel serverless: 5-10)
DB_POOL_MAX=10

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ==============================================================================
# CORS Configuration
# ==============================================================================
CLIENT_URL=http://localhost:4200
